# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs (forge doc output), hand-written guides are kept
docs/*
!docs/DEPLOY.md

# Environment files env/<dev|prod>.mk and their backups made by deploy.sh (contain PRIVATE_KEY).
# Plus .env: forge loads it on its own, a leftover one would leak into every environment.
env/*.mk
env/*.mk.bak.*
.env
.env.bak.*

# deploy.sh logs
deploy-logs/

# Node modules
node_modules/

abi.js
call.js
Unitest.sol
TestDeploy.sol
!test/*
!test/**/*

broadcast/*

.vscode
.idea
.vimrc
internal_docs/

lib/*

.tmp.deploy*