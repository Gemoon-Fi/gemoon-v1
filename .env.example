# Common
PRIVATE_KEY=<YOUR_PRIVATE_KEY>
# Final owner of Vault, HookManager and GemoonController, e.g. multisig (default: deployer).
# The vault is Ownable2Step: this account must call acceptOwnership after DeployGemoon.
GEMOON_OWNER=
# Owner of the three ProxyAdmins, i.e. who can upgrade (default: GEMOON_OWNER)
GEMOON_PROXY_ADMIN_OWNER=

POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
POSITION_MANAGER=0x429ba70129df741B2Ca2a85BC3A2a3328e5c09b4
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Pair token of every Meme pool; swap fees are charged and accounted in it
USDG_ADDRESS=

# HookManager
PROTOCOL_FEE_RECIPIENT=
HOOK_TOTAL_FEE_BIPS=125
HOOK_PROTOCOL_FEE_BIPS=25

# Vault
VAULT_KEEPER=
VAULT_SWAP_ADAPTER=
VAULT_ALLOWED_ASSETS=

# Filled from DeployGemoon logs; used by the upgrade and verify scripts
# (and by the standalone DeployVault to pre-wire controller and hook)
CONTROLLER_PROXY_ADDRESS=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
CONTROLLER_PROXY_ADMIN_ADDRESS=
HOOK_PROXY_ADDRESS=
HOOK_PROXY_ADMIN_ADDRESS=
VAULT_PROXY_ADDRESS=
VAULT_PROXY_ADMIN_ADDRESS=

# Fork tests (test/fork): devnet, Sepolia fork with Uniswap V4, chain id 1337.
# Leave empty to skip them. DEVNET_BLOCK pins the fork block, empty = latest.
DEVNET_RPC=https://anvil.devinside.tech
DEVNET_BLOCK=

# ProxyGemoonControllerUpgrade only
MULTISIG_OWNER_ADDRESS=
NATIVE_TOKEN_ADDRESS=0x760AfE86e5de5fa0Ee542fc7B7B713e1c5425701
